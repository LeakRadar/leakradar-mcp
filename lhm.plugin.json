            "default": null,
            "title": "Body"
          }
        },
        "required": [
          "operation"
        ],
        "title": "api_spendArguments",
        "type": "object"
      }
    },
    {
      "name": "api_export",
      "description": "Call one EXPORT operation: queue a CSV/TXT/JSON export or get a download link. The job runs in the background; poll with api_read 'GET /exports' and give the user the link, never paste the file content.",
      "inputSchema": {
